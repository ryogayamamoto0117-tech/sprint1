{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageSprint6LogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:ap-northeast-1:237575223564:log-group:/ecs/sprint6-app"
    }
  ]
}